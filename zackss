#!/bin/bash
# =============================================
#          ZackSS 1.5 - Free Fire Scanner
# =============================================

clear

# Banner
echo -e "\e[1;36m"
cat << "EOF"
╔════════════════════════════════════════════════════════════╗
║                                                            ║
║   ███████╗ █████╗  ██████╗██╗  ██╗███████╗███████╗███████╗ ║
║   ╚══███╔╝██╔══██╗██╔════╝██║ ██╔╝██╔════╝██╔════╝██╔════╝ ║
║     ███╔╝ ███████║██║     █████╔╝ █████╗  ███████╗███████╗ ║
║    ███╔╝  ██╔══██║██║     ██╔═██╗ ██╔══╝  ╚════██║╚════██║ ║
║   ███████╗██║  ██║╚██████╗██║  ██╗███████╗███████║███████║ ║
║   ╚══════╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝ ║
║                                                            ║
║                        ZACKSS 1.5                          ║
║                 Free Fire Analyzer                         ║
╚════════════════════════════════════════════════════════════╝
EOF
echo -e "\e[0m"

R='\e[1;31m'
G='\e[1;32m'
Y='\e[1;33m'
C='\e[1;36m'
W='\e[1;37m'
NC='\e[0m'

echo -e "${C}[+] Iniciando ZackSS 1.5...\n${NC}"

echo -e "${W}Modelo         : ${Y}$(getprop ro.product.model 2>/dev/null || echo "N/A")${NC}"
echo -e "${W}Android Version: ${Y}$(getprop ro.build.version.release 2>/dev/null || echo "N/A")${NC}\n"

DETECCOES=0

# Brevent
echo -e "${C}▶ Verificando Brevent...${NC}"
if [ -d "/data/data/com.oasisfeng.brevent" ] || [ -f "/data/local/tmp/brevent.sh" ]; then
    echo -e "${R}▲ Brevent detectado${NC}"
    ((DETECCOES++))
else
    echo -e "${G} Brevent não encontrado${NC}"
fi

# Root
echo -e "${C}▶ Verificando Root / Bypass...${NC}"
if [ -d "/data/adb" ] || command -v su >/dev/null 2>&1; then
    echo -e "${R}▲ Root/Bypass detectado${NC}"
    ((DETECCOES++))
else
    echo -e "${G} Nenhum root detectado${NC}"
fi

# Free Fire
echo -e "\n${C}▶ Analisando Free Fire...${NC}"
if [ -d "/sdcard/Android/data/com.dts.freefireth" ]; then
    echo -e "${R}▲ Pasta Free Fire encontrada${NC}"
    ((DETECCOES++))
fi

# Arquivos recentes
echo -e "\n${C}▶ Arquivos baixados (últimos 7 dias)...${NC}"
if [ -d "/sdcard/Download" ]; then
    RECENT=$(ls -1 /sdcard/Download/* 2>/dev/null | wc -l)
    if [ "$RECENT" -gt 0 ]; then
        echo -e "${R}▲ $RECENT arquivo(s) encontrado(s) na pasta Download${NC}"
        ((DETECCOES++))
    else
        echo -e "${G} Nenhum arquivo recente${NC}"
    fi
fi

echo -e "\n${C}════════════════════════════════════════════${NC}"
if [ $DETECCOES -gt 0 ]; then
    echo -e "${R}🚨 $DETECCOES detecção(ões) encontrada(s)${NC}"
    echo -e "${R}Possível manipulação detectada${NC}"
else
    echo -e "${G}✅ Nenhuma detecção grave encontrada${NC}"
fi

echo -e "\n${G}Scan finalizado por ZackSS 1.5${NC}"
echo -e "${Y}Em caso de dúvida, procure o Zack no Discord${NC}\n"

echo -e "${W}~/ZackSS-Android $ ${NC}"
