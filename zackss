#!/bin/bash
# =============================================
#          ZackSS 1.3 - Free Fire Scanner
# =============================================

clear

# Banner
echo -e "\e[1;36m"
cat << "EOF"
╔════════════════════════════════════════════════════════════╗
║                                                            ║
║   ███████╗ █████╗  ██████╗██╗  ██╗███████╗███████╗███████╗ ║
║   ╚══███╔╝██╔══██╗██╔════╝██║ ██╔╝██╔════╝██╔════╝██╔════╝ ║
║     ███╔╝ ███████║██║     █████╔╝ █████╗  ███████╗███████╗ ║
║    ███╔╝  ██╔══██║██║     ██╔═██╗ ██╔══╝  ╚════██║╚════██║ ║
║   ███████╗██║  ██║╚██████╗██║  ██╗███████╗███████║███████║ ║
║   ╚══════╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝ ║
║                                                            ║
║                        ZACKSS 1.3                          ║
║                 Free Fire Analyzer                         ║
╚════════════════════════════════════════════════════════════╝
EOF
echo -e "\e[0m"

R='\e[1;31m'
G='\e[1;32m'
Y='\e[1;33m'
C='\e[1;36m'
W='\e[1;37m'
NC='\e[0m'

echo -e "${C}[+] Preparando ambiente...${NC}"
pkg install -y coreutils toybox curl findutils > /dev/null 2>&1 || true

echo -e "${C}[+] Iniciando análise real...\n${NC}"

echo -e "${W}Modelo         : ${Y}$(getprop ro.product.model 2>/dev/null || echo "N/A")${NC}"
echo -e "${W}Android Version: ${Y}$(getprop ro.build.version.release 2>/dev/null || echo "N/A")${NC}\n"

DETECCOES=0

echo -e "${C}▶ Verificando Root / Bypass...${NC}"
if [ -d "/data/adb" ] || command -v su >/dev/null 2>&1; then
    echo -e "${R}▲ Indicadores de root/bypass detectados${NC}"
    ((DETECCOES++))
else
    echo -e "${G} Nenhum sinal óbvio de root encontrado${NC}"
fi

echo -e "${C}▶ Verificando WiFi Debugging...${NC}"
if getprop service.adb.tcp.port 2>/dev/null | grep -q "[0-9]"; then
    echo -e "${R}▲ WiFi Debugging ATIVO${NC}"
    ((DETECCOES++))
else
    echo -e "${G} WiFi Debugging não detectado${NC}"
fi

echo -e "\n${C}▶ Analisando Pastas do Free Fire...${NC}"
if [ -d "/sdcard/Android/data/com.dts.freefireth" ]; then
    echo -e "${R}▲ Pasta Free Fire encontrada${NC}"
    ((DETECCOES++))
fi

# ================== NOVA FUNÇÃO ==================
echo -e "\n${C}▶ Analisando arquivos baixados na última semana...${NC}"
DOWNLOAD_PATHS=("/sdcard/Download" "/sdcard/Downloads" "/storage/emulated/0/Download" "/storage/emulated/0/Downloads")

RECENT_FILES=0
for path in "${DOWNLOAD_PATHS[@]}"; do
    if [ -d "$path" ]; then
        echo -e "${Y}   Analisando: $path${NC}"
        RECENT=$(find "$path" -type f -mtime -7 2>/dev/null | wc -l)
        if [ "$RECENT" -gt 0 ]; then
            echo -e "${R}▲ $RECENT arquivo(s) baixado(s) nos últimos 7 dias${NC}"
            ((RECENT_FILES+=RECENT))
            ((DETECCOES++))
        fi
    fi
done

if [ $RECENT_FILES -eq 0 ]; then
    echo -e "${G} Nenhum arquivo recente encontrado nas pastas de Download${NC}"
fi

echo -e "\n${C}════════════════════════════════════════════${NC}"
if [ $DETECCOES -gt 0 ]; then
    echo -e "${R}🚨 $DETECCOES detecção(ões) encontrada(s)${NC}"
    echo -e "${R}Possível manipulação detectada${NC}"
else
    echo -e "${G}✅ Nenhuma detecção grave encontrada${NC}"
fi

echo -e "\n${G}Scan finalizado por ZackSS 1.3${NC}"
echo -e "${Y}Em caso de dúvida, procure o Keller no Discord${NC}\n"

echo -e "${W}~/ZackSS-Android $ ${NC}"
